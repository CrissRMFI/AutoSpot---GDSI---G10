# ══════════════════════════════════════════════════════════════════════════════
# AutoSpot — .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Variables de entorno / secretos ─────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

backend/.env
backend/.env.local
backend/.env.*.local
!backend/.env.example

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.coverage
coverage.xml
htmlcov/

.mypy_cache/
.ruff_cache/

# Entornos virtuales
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/

dist/
frontend/dist/

build/
frontend/build/

.vite/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs / Editores ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.claude

# ── Sistema operativo ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker / Runtime local ──────────────────────────────────────────────────
docker-data/
postgres-data/

# ── Archivos temporales ─────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.backup

scripts/