# ══════════════════════════════════════════════════════════════════════════════
# Variables de Entorno — AutoSpot Backend
#
# Instrucciones:
#   1. Copiar este archivo como `.env` en la misma ubicación:
#        cp .env.example .env
#   2. Modificar los valores según tu entorno local.
#   3. NUNCA commitear el archivo `.env` (ya está en .gitignore).
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
# Estas variables son compartidas por docker-compose.yml y por database.py.
DB_USER=autospot_user
DB_PASSWORD=autospot_pass
DB_HOST=localhost
DB_PORT=5433
DB_NAME=autospot_db
DB_NAME_TEST=autospot_test_db

# ── Nota sobre DB_HOST ───────────────────────────────────────────────────────
# - Si corrés la API DENTRO de Docker (docker compose up):     DB_HOST=db, DB_PORT=5432
# - Si corrés la API FUERA de Docker (uvicorn app.main:app):   DB_HOST=localhost, DB_PORT=5433
#   En este caso, el contenedor de PostgreSQL debe estar corriendo:
#     docker compose up db -d
