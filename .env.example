# ══════════════════════════════════════════════════════════════════════════════
# AutoSpot — Backend / Docker environment example
#
# Copiar este archivo como `.env` en la raíz del proyecto:
#   cp .env.example .env
#
# IMPORTANTE:
#   - No commitear `.env`.
#   - Cambiar JWT_SECRET_KEY en producción.
#   - En Docker Compose, el backend se conecta a PostgreSQL usando:
#       DB_HOST=db
#       DB_PORT=5432
#     aunque para acceso local desde tu máquina PostgreSQL queda publicado en:
#       localhost:5433
# ══════════════════════════════════════════════════════════════════════════════

# Database
DATABASE_URL=
DB_USER=autospot_user
DB_PASSWORD=autospot_pass
DB_HOST=localhost
DB_PORT=5433
DB_NAME=autospot_db
DB_NAME_TEST=autospot_test_db

# JWT
JWT_SECRET_KEY=generar-una-clave-segura-con-python-secrets-token-urlsafe
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary — almacenamiento de imágenes
# Obtener desde https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Environment
ENVIRONMENT=development